    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT v.id as viagem_id, v.data_inicio, v.data_fim, SUM(d.valor_total) as total, COUNT(d.id) as qtd_notas FROM viagens v LEFT JOIN despesas_viagem d ON d.phone = v.phone AND d.created_at >= v.data_inicio AND (v.data_fim IS NULL OR d.created_at <= v.data_fim) WHERE v.phone = '{{ $json.phone }}' AND v.status = 'ativa' GROUP BY v.id, v.data_inicio, v.data_fim",
