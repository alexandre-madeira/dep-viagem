                  {
                      "parameters":  {
                                         "jsCode":  "let data = $json;\nif (typeof $json.output === \u0027string\u0027) {\n  try { data = JSON.parse($json.output); } catch(e) {}\n} else if ($json.output \u0026\u0026 typeof $json.output === \u0027object\u0027) {\n  data = $json.output;\n}\n\nconst phone = $(\u0027WF-DPV.02 - TRIGGER | Iniciar Extra��o\u0027).item.json.phone;\nconst messageId = $(\u0027WF-DPV.02 - TRIGGER | Iniciar Extra��o\u0027).item.json.messageId;\n\nconst tipo = (String(data.tipo_pagador || $json.tipo_pagador || \u0027\u0027)).toLowerCase().trim().replace(/^null$/, \u0027\u0027) || null;\n\nconst formaInput = (String(data.forma_pagamento || $json.forma_pagamento || \u0027\u0027)).toLowerCase().trim();\nlet forma = null;\nif (formaInput \u0026\u0026 formaInput !== \u0027null\u0027) {\n  if (formaInput.startsWith(\u0027cart\u0027)) forma = \u0027cartao\u0027;\n  else if (formaInput === \u0027dinheiro\u0027) forma = \u0027dinheiro\u0027;\n  else forma = formaInput;\n}\n\nconst cpfRaw = data.cpf_cnpj_pagador || $json.cpf_cnpj_pagador;\nconst cpf = cpfRaw ? String(cpfRaw).replace(/[^0-9]/g, \u0027\u0027) : null;\n\nconst valor = parseFloat(data.valor_total || $json.valor_total) || 0;\nconst dataEmissao = data.data_emissao || $json.data_emissao || null;\nconst confianca = parseFloat(data.confianca || $json.confianca) || 0;\nconst camposOrigem = Array.isArray(data.campos_faltantes) ? data.campos_faltantes : [];\n\nconst combsValidas = [[\u0027empresa\u0027,\u0027cartao\u0027],[\u0027empresa\u0027,\u0027dinheiro\u0027],[\u0027particular\u0027,\u0027cartao\u0027],[\u0027particular\u0027,\u0027dinheiro\u0027]];\nconst erros = [];\nconst faltantes = [...camposOrigem];\n\nif (!tipo) faltantes.push(\u0027tipo_pagador\u0027);\nif (!forma) faltantes.push(\u0027forma_pagamento\u0027);\nif (!cpf) faltantes.push(\u0027cpf_cnpj_pagador\u0027);\nif (!dataEmissao) faltantes.push(\u0027data_emissao\u0027);\nif (valor \u003c= 0) erros.push(\u0027Valor deve ser maior que zero\u0027);\nif (valor \u003e 999999.99) erros.push(\u0027Valor acima do limite\u0027);\n\nif (cpf \u0026\u0026 cpf.length !== 11 \u0026\u0026 cpf.length !== 14) {\n  erros.push(\u0027CPF/CNPJ invalido: deve ter 11 ou 14 digitos (recebido: \u0027 + cpf.length + \u0027)\u0027);\n}\n\nif (dataEmissao) {\n  const d = new Date(dataEmissao + \u0027T00:00:00\u0027);\n  const hoje = new Date();\n  const limite90 = new Date();\n  limite90.setDate(hoje.getDate() - 90);\n  if (d \u003e hoje) erros.push(\u0027Data futura nao permitida\u0027);\n  if (d \u003c limite90) erros.push(\u0027Data muito antiga (mais de 90 dias)\u0027);\n}\n\nif (tipo \u0026\u0026 forma) {\n  const comboOk = combsValidas.some(c =\u003e c[0] === tipo \u0026\u0026 c[1] === forma);\n  if (!comboOk) erros.push(\u0027Combinacao invalida: \u0027 + tipo + \u0027 + \u0027 + forma + \u0027. Use: empresa/particular + cartao/dinheiro\u0027);\n}\n\nconst faltantesUnicos = [...new Set(faltantes)];\nconst valido = erros.length === 0 \u0026\u0026 faltantesUnicos.length === 0;\n\nlet motivoErro = null;\nif (!valido) {\n  const partes = [];\n  if (faltantesUnicos.length \u003e 0) partes.push(\u0027Campos nao identificados: \u0027 + faltantesUnicos.join(\u0027, \u0027));\n  if (erros.length \u003e 0) partes.push(erros.join(\u0027 | \u0027));\n  motivoErro = partes.join(\u0027 | \u0027);\n}\n\nconst itensRaw = data.itens_json || $json.itens_json;\nconst itensStr = Array.isArray(itensRaw) ? JSON.stringify(itensRaw) : (typeof itensRaw === \u0027string\u0027 ? itensRaw : \u0027[]\u0027);\n\nreturn [{\n  json: {\n    phone,\n    message_id: messageId,\n    estabelecimento: data.estabelecimento || $json.estabelecimento || null,\n    cnpj: data.cnpj || $json.cnpj || null,\n    valor_total: valor,\n    data_emissao: dataEmissao,\n    categoria: data.categoria || $json.categoria || \u0027outros\u0027,\n    itens_json: itensStr,\n    tipo_pagador: tipo,\n    forma_pagamento: forma,\n    cpf_cnpj_pagador: cpf || null,\n    sem_nf: false,\n    validado_manualmente: false,\n    confianca,\n    validacao_ok: valido,\n    campos_faltantes: faltantesUnicos,\n    erros_validacao: erros,\n    motivo_erro: motivoErro\n  }\n}];"
                                     },
