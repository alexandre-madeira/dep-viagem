    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.estabelecimento, d.data_emissao, d.categoria, d.valor_total, d.message_id FROM despesas_viagem d JOIN viagens v ON v.phone = d.phone AND d.created_at >= v.data_inicio AND (v.data_fim IS NULL OR d.created_at <= v.data_fim) WHERE v.id = {{ $json.body.viagem_id }} ORDER BY d.data_emissao ASC, d.id ASC",
        "options": {}
