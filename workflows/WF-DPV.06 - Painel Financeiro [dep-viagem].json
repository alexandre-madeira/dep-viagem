    {
      "parameters": {
        "jsCode": "const nfs = $input.all().map((item, i) => ({\n  ordem: i + 1,\n  arquivo: (i + 1).toString().padStart(2, '0') + '_' + (item.json.data_emissao || 'sem_data') + '_' + (item.json.estabelecimento || 'NF').replace(/[^a-zA-Z0-9]/g, '_').substring(0, 30) + '.jpg',\n  estabelecimento: item.json.estabelecimento,\n  categoria: item.json.categoria,\n  valor: item.json.valor_total,\n  data: item.json.data_emissao,\n  message_id: item.json.message_id\n}));\nreturn [{ json: { nfs, total: nfs.length } }];"
      },
