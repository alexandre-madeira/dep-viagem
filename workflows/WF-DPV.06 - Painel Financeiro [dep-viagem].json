    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT v.id, v.phone, v.nome_viagem, v.data_inicio, v.data_fim, v.status, COALESCE(f.nome, v.phone) as funcionario_nome, json_agg(json_build_object('id', d.id, 'estabelecimento', d.estabelecimento, 'cnpj', d.cnpj, 'valor_total', d.valor_total, 'data_emissao', d.data_emissao, 'categoria', d.categoria, 'message_id', d.message_id) ORDER BY d.data_emissao ASC) FILTER (WHERE d.id IS NOT NULL) as despesas FROM viagens v LEFT JOIN funcionarios f ON f.phone = v.phone LEFT JOIN despesas_viagem d ON d.phone = v.phone AND d.created_at >= v.data_inicio AND (v.data_fim IS NULL OR d.created_at <= v.data_fim) GROUP BY v.id, v.phone, v.nome_viagem, v.data_inicio, v.data_fim, v.status, f.nome ORDER BY v.data_inicio DESC",
        "options": {}
      },
